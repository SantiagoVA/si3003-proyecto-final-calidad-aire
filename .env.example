# ==============================================================================
# Configuración de Variables de Entorno - Agente de Calidad del Aire (SIATA/AMVA)
# Curso SI3003 - Inteligencia Artificial | Universidad EAFIT
# ==============================================================================
# NOTA DE REPRODUCIBILIDAD (PLAN B ACTIVO POR DISEÑO):
# El sistema soporta ejecución 100% funcional con o sin llaves API externas:
#   1. Si configura GROQ_API_KEY, NVIDIA_API_KEY u OPENAI_API_KEY, el agente usa
#      automáticamente el endpoint cloud compatible con OpenAI.
#   2. Si no configura llaves API, el agente activa su motor LLM local/híbrido
#      (Qwen2.5-0.5B-Instruct en PyTorch MPS/CPU + respaldo determinista ReAct),
#      garantizando ejecución inmediata sin costos ni fallos en la demostración.

# --- Opción A: Groq Cloud (Capa gratuita recomendada - OpenAI compatible) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Opción B: NVIDIA NIM (Capa gratuita académica - OpenAI compatible) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# --- Opción C: OpenAI o Endpoint Compatible Personalizado (ej. Ollama) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Parámetros del Agente y RAG ---
AGENT_MAX_STEPS=6
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

